# 複製本檔為 .env 並填入實際值。.env 已被 .gitignore 排除，不會進版控。

# ── 必填 ──────────────────────────────────────
# YouTube Data API v3 金鑰（Google Cloud Console → 憑證 → API 金鑰）
YOUTUBE_API_KEY=你的_API_KEY

# ── 選填（不設定就使用預設值）──────────────────
# OAuth 憑證檔路徑（預設：<專案根目錄>/secrets/ 下）
#CLIENT_SECRET_FILE=secrets/client_secret.json
#TOKEN_FILE=secrets/token.json

# 每日排程時間（24 小時制）
#SCHEDULE_TIME=16:05

# API 配額上限（units）
#YOUTUBE_DAILY_LIMIT=10000
#YOUTUBE_SOFT_LIMIT=8000

# OAuth 本機回呼埠號
#OAUTH_PORT=8080
